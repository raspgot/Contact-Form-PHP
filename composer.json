{
    "name": "raspgot/contact-form-php",
    "description": "A modern, secure and lightweight contact form for PHP projects with Bootstrap 5, AJAX, PHPMailer, and Google reCAPTCHA v3",
    "type": "project",
    "keywords": [
        "contact-form",
        "php",
        "phpmailer",
        "recaptcha",
        "bootstrap",
        "ajax",
        "smtp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Raspgot",
            "email": "contact@raspgot.fr",
            "homepage": "https://raspgot.fr"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "ContactForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContactForm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 AjaxForm.php",
        "cs-fix": "phpcbf --standard=PSR12 AjaxForm.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
